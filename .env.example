# Copy to .env and fill in your keys. Never commit .env to git.

# LLM — pick one or more (auto order: Groq → Claude → OpenAI)
# ASTRA_LLM_PROVIDER=auto|groq|anthropic|openai
# ASTRA_LLM_MODEL=llama-3.3-70b-versatile   # Groq default
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# Voice — ElevenLabs (Astra voice stack)
# Get key at elevenlabs.io — free tier is enough to start
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE=Adam
# ELEVENLABS_VOICE_ID=optional-direct-voice-id

# Your name for Astra_hello.py greeting
ASTRA_USER_NAME=Commander

# Auto-detect city from IP for weather (default on). Set false to disable.
# ASTRA_AUTO_LOCATION=true
# Manual override still works: set city to Hyderabad
# ASTRA_CITY=Hyderabad

# Stripe (optional — live checkout on portal)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CAMPUS=price_...
STRIPE_PRICE_STARTUP=price_...

# Portal URL for checkout redirects
ASTRA_PORTAL_URL=http://localhost:8503

# Cloud sync (optional — use ASTRA_SYNC_KEY for encrypted sync)
# ASTRA_SYNC_URL=
# ASTRA_SYNC_KEY=
